{
  "name": "@t402/svm",
  "version": "2.7.1",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "scripts": {
    "start": "tsx --env-file=.env index.ts",
    "build": "tsup",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "watch": "tsc --watch",
    "format": "prettier -c .prettierrc --write \"**/*.{ts,js,cjs,json,md}\"",
    "format:check": "prettier -c .prettierrc --check \"**/*.{ts,js,cjs,json,md}\"",
    "lint": "eslint . --ext .ts --fix",
    "lint:check": "eslint . --ext .ts"
  },
  "keywords": [
    "t402",
    "payment",
    "protocol",
    "svm",
    "solana"
  ],
  "license": "Apache-2.0",
  "author": "T402 Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/t402-io/t402.git",
    "directory": "sdks/typescript/packages/mechanisms/svm"
  },
  "description": "t402 Payment Protocol SVM Implementation",
  "devDependencies": {
    "@scure/base": "^1.2.6",
    "@eslint/js": "^9.39.3",
    "@types/node": "^25.2.3",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "eslint": "^10.0.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsdoc": "^62.6.0",
    "eslint-plugin-prettier": "^5.5.5",
    "glob": "^13.0.5",
    "prettier": "3.8.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@solana-program/compute-budget": "^0.13.0",
    "@solana-program/token": "^0.11.0",
    "@solana-program/token-2022": "^0.9.0",
    "@solana/kit": "^6.1.0",
    "@t402/core": "workspace:*"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.mts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./v1": {
      "import": {
        "types": "./dist/esm/v1/index.d.mts",
        "default": "./dist/esm/v1/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/v1/index.d.ts",
        "default": "./dist/cjs/v1/index.js"
      }
    },
    "./exact/client": {
      "import": {
        "types": "./dist/esm/exact/client/index.d.mts",
        "default": "./dist/esm/exact/client/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/exact/client/index.d.ts",
        "default": "./dist/cjs/exact/client/index.js"
      }
    },
    "./exact/server": {
      "import": {
        "types": "./dist/esm/exact/server/index.d.mts",
        "default": "./dist/esm/exact/server/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/exact/server/index.d.ts",
        "default": "./dist/cjs/exact/server/index.js"
      }
    },
    "./exact/facilitator": {
      "import": {
        "types": "./dist/esm/exact/facilitator/index.d.mts",
        "default": "./dist/esm/exact/facilitator/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/exact/facilitator/index.d.ts",
        "default": "./dist/cjs/exact/facilitator/index.js"
      }
    },
    "./exact/v1/client": {
      "import": {
        "types": "./dist/esm/exact/v1/client/index.d.mts",
        "default": "./dist/esm/exact/v1/client/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/exact/v1/client/index.d.ts",
        "default": "./dist/cjs/exact/v1/client/index.js"
      }
    },
    "./exact/v1/facilitator": {
      "import": {
        "types": "./dist/esm/exact/v1/facilitator/index.d.mts",
        "default": "./dist/esm/exact/v1/facilitator/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/exact/v1/facilitator/index.d.ts",
        "default": "./dist/cjs/exact/v1/facilitator/index.js"
      }
    },
    "./upto": {
      "import": {
        "types": "./dist/esm/upto/index.d.mts",
        "default": "./dist/esm/upto/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/upto/index.d.ts",
        "default": "./dist/cjs/upto/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "homepage": "https://t402.io",
  "publishConfig": {
    "access": "public"
  }
}
