{
  "name": "@t402/btc",
  "version": "2.7.0",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "scripts": {
    "start": "tsx --env-file=.env index.ts",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "watch": "tsc --watch",
    "format": "prettier -c .prettierrc --write \"**/*.{ts,js,cjs,json,md}\"",
    "format:check": "prettier -c .prettierrc --check \"**/*.{ts,js,cjs,json,md}\"",
    "lint": "eslint . --ext .ts --fix",
    "lint:check": "eslint . --ext .ts"
  },
  "keywords": [
    "t402",
    "payment",
    "protocol",
    "bitcoin",
    "lightning",
    "btc"
  ],
  "license": "Apache-2.0",
  "author": "T402 Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/t402-io/t402.git",
    "directory": "sdks/typescript/packages/mechanisms/btc"
  },
  "description": "t402 Payment Protocol Bitcoin & Lightning Network Implementation",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.2.2",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "eslint": "^9.24.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsdoc": "^62.5.4",
    "eslint-plugin-prettier": "^5.5.5",
    "glob": "^13.0.0",
    "prettier": "3.8.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.1.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@t402/core": "workspace:*"
  },
  "peerDependencies": {
    "bitcoinjs-lib": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "bitcoinjs-lib": {
      "optional": true
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.mts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./exact/client": {
      "import": {
        "types": "./dist/esm/exact/client/index.d.mts",
        "default": "./dist/esm/exact/client/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/exact/client/index.d.ts",
        "default": "./dist/cjs/exact/client/index.js"
      }
    },
    "./exact/server": {
      "import": {
        "types": "./dist/esm/exact/server/index.d.mts",
        "default": "./dist/esm/exact/server/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/exact/server/index.d.ts",
        "default": "./dist/cjs/exact/server/index.js"
      }
    },
    "./exact/facilitator": {
      "import": {
        "types": "./dist/esm/exact/facilitator/index.d.mts",
        "default": "./dist/esm/exact/facilitator/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/exact/facilitator/index.d.ts",
        "default": "./dist/cjs/exact/facilitator/index.js"
      }
    },
    "./lightning/client": {
      "import": {
        "types": "./dist/esm/lightning/client/index.d.mts",
        "default": "./dist/esm/lightning/client/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/lightning/client/index.d.ts",
        "default": "./dist/cjs/lightning/client/index.js"
      }
    },
    "./lightning/server": {
      "import": {
        "types": "./dist/esm/lightning/server/index.d.mts",
        "default": "./dist/esm/lightning/server/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/lightning/server/index.d.ts",
        "default": "./dist/cjs/lightning/server/index.js"
      }
    },
    "./lightning/facilitator": {
      "import": {
        "types": "./dist/esm/lightning/facilitator/index.d.mts",
        "default": "./dist/esm/lightning/facilitator/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/lightning/facilitator/index.d.ts",
        "default": "./dist/cjs/lightning/facilitator/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "homepage": "https://t402.io",
  "publishConfig": {
    "access": "public"
  }
}
