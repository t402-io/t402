{
  "name": "@t402/extensions",
  "version": "2.8.0",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "scripts": {
    "start": "tsx --env-file=.env index.ts",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "watch": "tsc --watch",
    "format": "prettier -c .prettierrc --write \"**/*.{ts,js,cjs,json,md}\"",
    "format:check": "prettier -c .prettierrc --check \"**/*.{ts,js,cjs,json,md}\"",
    "lint": "eslint . --fix",
    "lint:check": "eslint ."
  },
  "keywords": [
    "t402",
    "payment",
    "protocol",
    "extensions"
  ],
  "license": "Apache-2.0",
  "author": "T402 Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/t402-io/t402.git",
    "directory": "sdks/typescript/packages/extensions"
  },
  "description": "t402 Payment Protocol Extensions",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "eslint": "^10.0.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsdoc": "^62.8.0",
    "eslint-plugin-prettier": "^5.5.5",
    "glob": "^13.0.6",
    "prettier": "3.8.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@t402/core": "workspace:*",
    "@noble/curves": "^1.8.1",
    "@noble/hashes": "^1.7.1",
    "ajv": "^8.18.0"
  },
  "peerDependencies": {
    "viem": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "viem": {
      "optional": true
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.mts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./bazaar": {
      "import": {
        "types": "./dist/esm/bazaar/index.d.mts",
        "default": "./dist/esm/bazaar/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/bazaar/index.d.ts",
        "default": "./dist/cjs/bazaar/index.js"
      }
    },
    "./sign-in-with-x": {
      "import": {
        "types": "./dist/esm/sign-in-with-x/index.d.mts",
        "default": "./dist/esm/sign-in-with-x/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/sign-in-with-x/index.d.ts",
        "default": "./dist/cjs/sign-in-with-x/index.js"
      }
    },
    "./payment-id": {
      "import": {
        "types": "./dist/esm/payment-id/index.d.mts",
        "default": "./dist/esm/payment-id/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/payment-id/index.d.ts",
        "default": "./dist/cjs/payment-id/index.js"
      }
    },
    "./eip2612-gas-sponsoring": {
      "import": {
        "types": "./dist/esm/eip2612-gas-sponsoring/index.d.mts",
        "default": "./dist/esm/eip2612-gas-sponsoring/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/eip2612-gas-sponsoring/index.d.ts",
        "default": "./dist/cjs/eip2612-gas-sponsoring/index.js"
      }
    },
    "./erc20-approval-gas-sponsoring": {
      "import": {
        "types": "./dist/esm/erc20-approval-gas-sponsoring/index.d.mts",
        "default": "./dist/esm/erc20-approval-gas-sponsoring/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/erc20-approval-gas-sponsoring/index.d.ts",
        "default": "./dist/cjs/erc20-approval-gas-sponsoring/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "homepage": "https://t402.io",
  "publishConfig": {
    "access": "public"
  }
}
