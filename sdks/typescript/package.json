{
  "name": "t402_monorepo",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=10.7.0"
  },
  "packageManager": "pnpm@10.7.0",
  "private": "true",
  "version": "2.6.0",
  "pnpm": {
    "overrides": {
      "happy-dom": ">=20.0.0",
      "glob": ">=13.0.1",
      "lodash": ">=4.17.23",
      "vite": ">=6.3.6",
      "h3": ">=1.15.5",
      "axios": ">=1.12.0",
      "viem": "^2.44.2",
      "@tonconnect/bridge-sdk": "0.2.4",
      "minimatch": ">=10.2.1",
      "validator": ">=13.15.22",
      "secp256k1": ">=5.0.1",
      "markdown-it": ">=14.1.1",
      "qs": ">=6.14.2",
      "@eslint/eslintrc": ">=3.3.3",
      "bn.js": ">=5.2.3"
    }
  },
  "description": "t402 Payment Protocol Monorepo",
  "main": "index.js",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "lint:check": "turbo run lint:check",
    "format:check": "turbo run format:check",
    "test": "turbo run test",
    "test:workspace": "vitest run",
    "test:workspace:watch": "vitest",
    "test:workspace:coverage": "vitest run --coverage",
    "test:integration": "turbo run test:integration",
    "test:all": "pnpm test && pnpm test:integration",
    "bench": "turbo run bench",
    "bench:core": "vitest bench --dir packages/core/src/bench",
    "bench:evm": "vitest bench --dir packages/mechanisms/evm/src/bench",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "pnpm build && changeset publish",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch"
  },
  "keywords": [],
  "author": "T402 Team",
  "license": "Apache-2.0",
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.0",
    "@eslint/js": "^9.39.2",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.2",
    "tsup": "^8.5.1",
    "turbo": "^2.8.10",
    "typedoc": "^0.28.17",
    "typedoc-plugin-markdown": "^4.10.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
