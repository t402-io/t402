{
  "name": "@t402/react-native",
  "version": "2.5.0",
  "description": "React Native SDK for t402 payments",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "react-native": "./dist/esm/index.mjs",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsup",
    "format": "prettier -c .prettierrc --write \"**/*.{ts,tsx,js,cjs,json,md}\"",
    "format:check": "prettier -c .prettierrc --check \"**/*.{ts,tsx,js,cjs,json,md}\"",
    "lint": "eslint . --ext .ts,.tsx --fix",
    "lint:check": "eslint . --ext .ts,.tsx"
  },
  "keywords": [
    "t402",
    "react-native",
    "payment",
    "http-402",
    "mobile",
    "stablecoin"
  ],
  "license": "Apache-2.0",
  "author": "T402 Team",
  "repository": "https://github.com/t402-io/t402",
  "devDependencies": {
    "@types/node": "^25.2.2",
    "@types/react": "^19",
    "prettier": "3.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@t402/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.72.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ]
}
