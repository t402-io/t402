# T402 Facilitator Service Configuration

# Server
PORT=8080
ENVIRONMENT=development

# ===================
# Database Configuration
# ===================
# PostgreSQL connection URL
DATABASE_URL=postgres://facilitator:password@localhost:5432/facilitator?sslmode=disable
# Maximum number of open connections (default: 25)
DATABASE_MAX_CONNS=25
# Maximum number of idle connections (default: 5)
DATABASE_IDLE_CONNS=5
# Run migrations on startup (default: true)
DATABASE_AUTO_MIGRATE=true

# Redis
REDIS_URL=redis://localhost:6379
# Required in production (docker-compose.prod.yaml)
REDIS_PASSWORD=

# Grafana (required in production)
GRAFANA_PASSWORD=

# Rate Limiting
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=60

# ===================
# API Key Authentication
# ===================
# Comma-separated list of API keys with optional names: "key1:name1,key2:name2"
# If set, requests without a valid API key will be rejected
API_KEYS=
# Set to true to require API keys for all requests (except /health, /ready, /metrics, /supported)
API_KEY_REQUIRED=false

# ===================
# EVM Configuration
# ===================
EVM_PRIVATE_KEY=

# RPC Endpoints (use your own for production)
ETH_RPC=https://eth.llamarpc.com
ARBITRUM_RPC=https://arb1.arbitrum.io/rpc
BASE_RPC=https://mainnet.base.org
OPTIMISM_RPC=https://mainnet.optimism.io
INK_RPC=https://rpc-gel.inkonchain.com
BERACHAIN_RPC=https://rpc.berachain.com
UNICHAIN_RPC=https://mainnet.unichain.org

# ===================
# TON Configuration
# ===================
# 24-word mnemonic or 64-character hex private key
TON_MNEMONIC=
TON_RPC=https://toncenter.com/api/v2/jsonRPC
TON_TESTNET_RPC=https://testnet.toncenter.com/api/v2/jsonRPC
# Pre-computed wallet addresses (required for TON support)
# Derive these using TON wallet tools from your mnemonic
TON_MAINNET_ADDRESS=
TON_TESTNET_ADDRESS=

# ===================
# TRON Configuration
# ===================
TRON_PRIVATE_KEY=
TRON_RPC=https://api.trongrid.io

# ===================
# Solana Configuration
# ===================
SVM_PRIVATE_KEY=
SOLANA_RPC=https://api.mainnet-beta.solana.com

# ===================
# Cosmos/Noble Configuration
# ===================
# REST API endpoints (defaults use public RPCs)
COSMOS_MAINNET_REST=https://noble-api.polkachu.com
COSMOS_TESTNET_REST=https://api.testnet.noble.strange.love
# Facilitator addresses on Noble (required for Cosmos support)
# These are the addresses where payments should be sent
COSMOS_MAINNET_ADDRESS=
COSMOS_TESTNET_ADDRESS=

# ===================
# OpenTelemetry Configuration
# ===================
# Enable distributed tracing (default: false)
OTEL_ENABLED=false
# OTLP exporter endpoint (default: localhost:4317)
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
# OTLP protocol: grpc or http (default: grpc)
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# Use insecure connection (default: true for development)
OTEL_EXPORTER_OTLP_INSECURE=true
# Trace sampling rate: 0.0 to 1.0 (default: 1.0 = 100%)
OTEL_TRACES_SAMPLER_ARG=1.0
