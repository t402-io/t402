{
  "name": "@t402/cli",
  "version": "2.8.1",
  "description": "Command-line interface for the T402 payment protocol",
  "keywords": [
    "t402",
    "usdt",
    "payment",
    "cli",
    "tether",
    "wdk"
  ],
  "license": "Apache-2.0",
  "author": "T402 Contributors",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "bin": {
    "t402": "./dist/esm/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@t402/core": "workspace:*",
    "chalk": "^5.3.0",
    "commander": "^14.0.3",
    "conf": "^15.1.0",
    "ora": "^9.4.0",
    "viem": "^2.48.8"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "glob": "^13.0.6",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://t402.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/t402-io/t402.git",
    "directory": "sdks/typescript/packages/cli"
  }
}
