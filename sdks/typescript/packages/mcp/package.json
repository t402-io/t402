{
  "name": "@t402/mcp",
  "version": "2.7.1",
  "description": "t402 Payment Protocol MCP Server for AI Agents",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "bin": {
    "t402-mcp": "./bin/t402-mcp.js"
  },
  "scripts": {
    "start": "node ./bin/t402-mcp.js",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier -c .prettierrc --write \"**/*.{ts,js,cjs,json,md}\"",
    "format:check": "prettier -c .prettierrc --check \"**/*.{ts,js,cjs,json,md}\"",
    "lint": "eslint . --ext .ts --fix",
    "lint:check": "eslint . --ext .ts"
  },
  "keywords": [
    "t402",
    "mcp",
    "model-context-protocol",
    "ai",
    "agent",
    "payment",
    "claude"
  ],
  "license": "Apache-2.0",
  "author": "T402 Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/t402-io/t402.git",
    "directory": "sdks/typescript/packages/mcp"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@types/node": "^25.3.3",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^10.0.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsdoc": "^62.7.1",
    "eslint-plugin-prettier": "^5.5.5",
    "glob": "^13.0.6",
    "prettier": "3.8.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@t402/core": "workspace:*",
    "@t402/erc8004": "workspace:*",
    "@t402/evm": "workspace:*",
    "zod": "^3.24.2"
  },
  "peerDependencies": {
    "viem": "^2.0.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.mts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/esm/server/index.d.mts",
        "default": "./dist/esm/server/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/server/index.d.ts",
        "default": "./dist/cjs/server/index.js"
      }
    },
    "./tools": {
      "import": {
        "types": "./dist/esm/tools/index.d.mts",
        "default": "./dist/esm/tools/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/tools/index.d.ts",
        "default": "./dist/cjs/tools/index.js"
      }
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "homepage": "https://t402.io",
  "publishConfig": {
    "access": "public"
  }
}
