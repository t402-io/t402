# WalletConnect Cloud project ID (get from https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Default mode: "live" or "demo"
NEXT_PUBLIC_DEMO_MODE=demo

# Facilitator URL
NEXT_PUBLIC_FACILITATOR_URL=https://facilitator.t402.io

# Facilitator wallet address (receives payments)
DEMO_PAY_TO_ADDRESS=0xC88f67e776f16DcFBf42e6bDda1B82604448899B

# Use testnet (Base Sepolia)
NEXT_PUBLIC_TESTNET=true

# Anthropic API key for AI query scenario (optional, falls back to mock)
ANTHROPIC_API_KEY=

# ERC-4337 Gasless Payment Configuration (optional)
# Get API key from https://dashboard.pimlico.io
NEXT_PUBLIC_BUNDLER_URL=https://api.pimlico.io/v2/base-sepolia/rpc?apikey=YOUR_PIMLICO_API_KEY
NEXT_PUBLIC_PAYMASTER_URL=https://api.pimlico.io/v2/base-sepolia/rpc?apikey=YOUR_PIMLICO_API_KEY
NEXT_PUBLIC_PAYMASTER_ADDRESS=0x0000000000000000000000000000000000000000
