{
  "name": "@t402/paywall",
  "version": "2.3.1",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "scripts": {
    "start": "tsx --env-file=.env index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsup",
    "build:paywall": "tsx src/evm/build.ts && tsx src/svm/build.ts && tsx src/ton/build.ts && tsx src/tron/build.ts && tsx src/stacks/build.ts && tsx src/cosmos/build.ts && tsx src/near/build.ts",
    "watch": "tsc --watch",
    "format": "prettier -c .prettierrc --write \"**/*.{ts,js,cjs,json,md}\"",
    "format:check": "prettier -c .prettierrc --check \"**/*.{ts,js,cjs,json,md}\"",
    "lint": "eslint . --ext .ts --fix",
    "lint:check": "eslint . --ext .ts"
  },
  "keywords": [
    "t402",
    "paywall",
    "payment",
    "http-402"
  ],
  "license": "Apache-2.0",
  "author": "T402 Team",
  "repository": "https://github.com/t402-io/t402",
  "description": "t402 Payment Protocol Paywall UI",
  "devDependencies": {
    "@craftamap/esbuild-plugin-html": "^0.9.0",
    "@eslint/js": "^9.24.0",
    "@t402/evm": "workspace:*",
    "@t402/svm": "workspace:*",
    "@t402/ton": "workspace:*",
    "@t402/tron": "workspace:*",
    "@types/node": "^22.13.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.29.1",
    "@typescript-eslint/parser": "^8.29.1",
    "buffer": "^6.0.3",
    "esbuild": "^0.25.4",
    "eslint": "^9.24.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsdoc": "^50.6.9",
    "eslint-plugin-prettier": "^5.2.6",
    "glob": "^13.0.0",
    "prettier": "3.5.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.0.5",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@scure/base": "^1.2.6",
    "@solana-program/compute-budget": "^0.8.0",
    "@solana-program/token": "^0.5.1",
    "@solana-program/token-2022": "^0.6.1",
    "@solana/kit": "^5.4.0",
    "@solana/transaction-confirmation": "^5.4.0",
    "@solana/wallet-standard-features": "^1.3.0",
    "@t402/core": "workspace:*",
    "@t402/stacks": "workspace:*",
    "@tanstack/react-query": "^5.90.7",
    "@ton/core": "^0.62.1",
    "@ton/ton": "^16.1.0",
    "@tonconnect/ui-react": "^2.0.12",
    "@wagmi/connectors": "^7.1.2",
    "@wagmi/core": "^3.2.2",
    "@wallet-standard/app": "^1.1.0",
    "@wallet-standard/base": "^1.1.0",
    "@wallet-standard/features": "^1.1.0",
    "viem": "^2.44.2",
    "wagmi": "^2.17.1",
    "zod": "^3.24.2"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./evm": {
      "import": {
        "types": "./dist/esm/evm/index.d.ts",
        "default": "./dist/esm/evm/index.js"
      },
      "require": {
        "types": "./dist/cjs/evm/index.d.cts",
        "default": "./dist/cjs/evm/index.cjs"
      }
    },
    "./svm": {
      "import": {
        "types": "./dist/esm/svm/index.d.ts",
        "default": "./dist/esm/svm/index.js"
      },
      "require": {
        "types": "./dist/cjs/svm/index.d.cts",
        "default": "./dist/cjs/svm/index.cjs"
      }
    },
    "./ton": {
      "import": {
        "types": "./dist/esm/ton/index.d.ts",
        "default": "./dist/esm/ton/index.js"
      },
      "require": {
        "types": "./dist/cjs/ton/index.d.cts",
        "default": "./dist/cjs/ton/index.cjs"
      }
    },
    "./tron": {
      "import": {
        "types": "./dist/esm/tron/index.d.ts",
        "default": "./dist/esm/tron/index.js"
      },
      "require": {
        "types": "./dist/cjs/tron/index.d.cts",
        "default": "./dist/cjs/tron/index.cjs"
      }
    },
    "./stacks": {
      "import": {
        "types": "./dist/esm/stacks/index.d.ts",
        "default": "./dist/esm/stacks/index.js"
      },
      "require": {
        "types": "./dist/cjs/stacks/index.d.cts",
        "default": "./dist/cjs/stacks/index.cjs"
      }
    },
    "./cosmos": {
      "import": {
        "types": "./dist/esm/cosmos/index.d.ts",
        "default": "./dist/esm/cosmos/index.js"
      },
      "require": {
        "types": "./dist/cjs/cosmos/index.d.cts",
        "default": "./dist/cjs/cosmos/index.cjs"
      }
    },
    "./near": {
      "import": {
        "types": "./dist/esm/near/index.d.ts",
        "default": "./dist/esm/near/index.js"
      },
      "require": {
        "types": "./dist/cjs/near/index.d.cts",
        "default": "./dist/cjs/near/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ]
}
