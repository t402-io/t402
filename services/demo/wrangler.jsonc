{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "t402-demo",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "demo.t402.io/*",
      "zone_name": "t402.io"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_FACILITATOR_URL": "https://facilitator.t402.io"
  }
}
