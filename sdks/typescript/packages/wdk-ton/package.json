{
  "name": "@t402/wdk-ton",
  "version": "2.5.0",
  "description": "Server-side TON wallet management with @ton/walletkit for T402",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "scripts": {
    "build": "tsup",
    "test": "vitest run --pool=forks",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts --fix",
    "lint:check": "eslint . --ext .ts",
    "format": "prettier -c .prettierrc --write \"**/*.{ts,js,cjs,json,md}\"",
    "format:check": "prettier -c .prettierrc --check \"**/*.{ts,js,cjs,json,md}\""
  },
  "keywords": [
    "t402",
    "payment",
    "protocol",
    "wdk",
    "tether",
    "ton",
    "wallet"
  ],
  "license": "Apache-2.0",
  "author": "T402 Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/t402-io/t402",
    "directory": "sdks/typescript/packages/wdk-ton"
  },
  "dependencies": {
    "@t402/core": "workspace:*",
    "@t402/wdk": "workspace:*"
  },
  "peerDependencies": {
    "@ton/walletkit": ">=0.0.5",
    "@ton/core": ">=0.56.0",
    "@ton/crypto": ">=3.2.0"
  },
  "peerDependenciesMeta": {
    "@ton/walletkit": {
      "optional": true
    },
    "@ton/core": {
      "optional": true
    },
    "@ton/crypto": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.2.2",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "eslint": "^9.24.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsdoc": "^62.5.4",
    "eslint-plugin-prettier": "^5.5.5",
    "glob": "^13.0.0",
    "prettier": "3.8.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.1.0",
    "vitest": "^3.2.4"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.mts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "homepage": "https://t402.io",
  "publishConfig": {
    "access": "public"
  }
}
